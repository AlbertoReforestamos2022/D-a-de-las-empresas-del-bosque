{
  "apiVersion": 2,
  "name": "diadelasempresasdelbosque/texto-imagen",
  "title": "Texto + Imagen DEB",
  "category": "deb-theme",
  "icon": "align-pull-left",
  "description": "Sección con texto e imagen lado a lado",
  "attributes": {
    "titulo": {
      "type": "string",
      "source": "html",
      "selector": "h2"
    },
    "contenido": {
      "type": "string",
      "source": "html",
      "selector": ".contenido"
    },
    "imagen": {
      "type": "string",
      "default": ""
    },
    "imagenAlt": {
      "type": "string",
      "default": "Imagen"
    },
    "imagenPosicion": {
      "type": "string",
      "default": "right"
    },
    "showButton": {
      "type": "boolean",
      "default": false
    },
    "buttonText": {
      "type": "string",
      "default": "Conoce Más"
    },
    "buttonUrl": {
      "type": "string",
      "default": "#"
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "tituloColor": {
      "type": "string",
      "default": ""
    },
    "contenidoColor": {
      "type": "string",
      "default": ""
    },
    "buttonBgColor": {
      "type": "string",
      "default": "#2d6a4f"
    },
    "buttonTextColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "tituloFontSize": {
      "type": "number",
      "default": 36
    },
    "contenidoFontSize": {
      "type": "number",
      "default": 16
    },
    "tituloFontWeight": {
      "type": "string",
      "default": "700"
    },
    "contenidoFontWeight": {
      "type": "string",
      "default": "400"
    },
    "textAlign": {
      "type": "string",
      "default": "left"
    }
  }
}