{
  "apiVersion": 2,
  "name": "diadelasempresasdelbosque/carousel",
  "title": "Carrusel DEB",
  "category": "deb-theme",
  "icon": "images-alt2",
  "description": "Carrusel de imágenes personalizable",
  "attributes": {
    "titulo": {
      "type": "string",
      "source": "html",
      "selector": "h2",
      "default": "Galería"
    },
    "descripcion": {
      "type": "string",
      "source": "html",
      "selector": ".section-description",
      "default": "Conoce nuestro trabajo"
    },
    "imagenes": {
      "type": "array",
      "default": []
    },
    "showControls": {
      "type": "boolean",
      "default": true
    },
    "showIndicators": {
      "type": "boolean",
      "default": true
    },
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "interval": {
      "type": "number",
      "default": 5000
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "tituloColor": {
      "type": "string",
      "default": ""
    },
    "descripcionColor": {
      "type": "string",
      "default": ""
    },
    "captionBgColor": {
      "type": "string",
      "default": "rgba(0, 0, 0, 0.7)"
    },
    "captionTextColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "tituloFontSize": {
      "type": "number",
      "default": 40
    },
    "descripcionFontSize": {
      "type": "number",
      "default": 18
    },
    "textAlign": {
      "type": "string",
      "default": "center"
    }
  }
}