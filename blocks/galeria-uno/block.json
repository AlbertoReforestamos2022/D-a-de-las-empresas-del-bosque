{
  "apiVersion": 2,
  "name": "diadelasempresasdelbosque/galeria",
  "title": "Galería Uno DEB",
  "category": "deb-theme",
  "icon": "images-alt2",
  "description": "Galería con animación marquee horizontal",
  "attributes": {
    "titulo": {
      "type": "string",
      "source": "html",
      "selector": "h2",
      "default": "Galería"
    },
    "descripcion": {
      "type": "string",
      "source": "html",
      "selector": ".lead",
      "default": "Lorem ipsum dolor sit amet consectetur, adipisicing elit."
    },
    "imagenes": {
      "type": "array",
      "default": [
        { "url": "https://via.placeholder.com/320x200", "alt": "Imagen 1" },
        { "url": "https://via.placeholder.com/320x200", "alt": "Imagen 2" },
        { "url": "https://via.placeholder.com/320x200", "alt": "Imagen 3" }
      ]
    },
    "velocidad": {
      "type": "number",
      "default": 30
    }
  }
}