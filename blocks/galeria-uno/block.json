{
  "apiVersion": 2,
  "name": "diadelasempresasdelbosque/galeria",
  "title": "Galería tabs DEB",
  "category": "deb-theme",
  "icon": "format-gallery",
  "description": "Galería de imágenes con tabs",
  "attributes": {
    "titulo": {
      "type": "string",
      "source": "html",
      "selector": "h2",
      "default": "Galería"
    },
    "descripcion": {
      "type": "string",
      "source": "html",
      "selector": ".section-description",
      "default": "Explora nuestras imágenes"
    },
    "categorias": {
      "type": "array",
      "default": []
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "tituloColor": {
      "type": "string",
      "default": ""
    },
    "descripcionColor": {
      "type": "string",
      "default": ""
    },
    "tabActiveColor": {
      "type": "string",
      "default": "#2d6a4f"
    },
    "tabInactiveColor": {
      "type": "string",
      "default": "#6c757d"
    },
    "tituloFontSize": {
      "type": "number",
      "default": 40
    },
    "descripcionFontSize": {
      "type": "number",
      "default": 18
    },
    "textAlign": {
      "type": "string",
      "default": "center"
    }
  }
}