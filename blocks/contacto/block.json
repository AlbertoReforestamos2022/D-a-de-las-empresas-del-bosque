{
  "apiVersion": 2,
  "name": "diadelasempresasdelbosque/contacto",
  "title": "Ubicación y Contacto DEB",
  "category": "deb-theme",
  "icon": "location",
  "description": "Mapa con información de contacto (WhatsApp, Email, Teléfono)",
  "attributes": {
    "titulo": {
      "type": "string",
      "source": "html",
      "selector": "h2",
      "default": "Encuéntranos"
    },
    "descripcion": {
      "type": "string",
      "source": "html",
      "selector": ".section-description",
      "default": "Visítanos o contáctanos"
    },
    "tituloDireccion": {
      "type": "string",
      "default": "Visítanos o contáctanos"
    },    
    "direccion": {
      "type": "string",
      "default": "Calle Example 123, Ciudad, País"
    },
    "mapaUrl": {
      "type": "string",
      "default": ""
    },
    "telefono": {
      "type": "string",
      "default": "+52 123 456 7890"
    },
    "email": {
      "type": "string",
      "default": "contacto@ejemplo.com"
    },
    "whatsapp": {
      "type": "string",
      "default": "+5212345678901"
    },
    "mensajeWhatsapp": {
      "type": "string",
      "default": "Hola, me gustaría obtener más información"
    },
    "horario": {
      "type": "string",
      "default": "Lunes a Viernes: 9:00 AM - 6:00 PM"
    },
    "mostrarTituloDireccion": {
      "type": "boolean",
      "default": true
    },
    "mostrarDireccion": {
      "type": "boolean",
      "default": true
    },
    "mostrarTelefono": {
      "type": "boolean",
      "default": true
    },
    "mostrarEmail": {
      "type": "boolean",
      "default": true
    },
    "mostrarWhatsapp": {
      "type": "boolean",
      "default": true
    },
    "mostrarHorario": {
      "type": "boolean",
      "default": true
    },
    "mapaAltura": {
      "type": "number",
      "default": 400
    },
    "mapaPosicion": {
      "type": "string",
      "default": "izquierda"
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "tituloColor": {
      "type": "string",
      "default": ""
    },
    "descripcionColor": {
      "type": "string",
      "default": ""
    },
    "cardBgColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "cardTextColor": {
      "type": "string",
      "default": "#333333"
    },
    "iconColor": {
      "type": "string",
      "default": "#2d6a4f"
    },
    "whatsappButtonBg": {
      "type": "string",
      "default": "#25d366"
    },
    "whatsappButtonText": {
      "type": "string",
      "default": "#ffffff"
    },
    "tituloFontSize": {
      "type": "number",
      "default": 40
    },
    "descripcionFontSize": {
      "type": "number",
      "default": 18
    },
    "textAlign": {
      "type": "string",
      "default": "center"
    }
  }
}