{
  "apiVersion": 2,
  "name": "diadelasempresasdelbosque/timeline",
  "title": "Timeline DEB",
  "category": "deb-theme",
  "icon": "calendar-alt",
  "description": "Línea del tiempo personalizable",
  "attributes": {
    "titulo": {
      "type": "string",
      "source": "html",
      "selector": "h2",
      "default": "Nuestra Historia"
    },
    "descripcion": {
      "type": "string",
      "source": "html",
      "selector": ".section-description",
      "default": "Conoce los momentos más importantes"
    },
    "items": {
      "type": "array",
      "default": [
        {
          "year": "2024",
          "texto": "Primer hito importante",
          "imagen": ""
        }
      ]
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "tituloColor": {
      "type": "string",
      "default": ""
    },
    "descripcionColor": {
      "type": "string",
      "default": ""
    },
    "lineColor": {
      "type": "string",
      "default": "#2d6a4f"
    },
    "badgeColor": {
      "type": "string",
      "default": "#2d6a4f"
    },
    "cardTextColor": {
      "type": "string",
      "default": ""
    },
    "tituloFontSize": {
      "type": "number",
      "default": 40
    },
    "descripcionFontSize": {
      "type": "number",
      "default": 18
    },
    "textAlign": {
      "type": "string",
      "default": "center"
    }
  }
}