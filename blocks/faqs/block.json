{
  "apiVersion": 2,
  "name": "diadelasempresasdelbosque/faq",
  "title": "FAQ DEB",
  "category": "deb-theme",
  "icon": "editor-help",
  "description": "Preguntas frecuentes con acordeón",
  "attributes": {
    "titulo": {
      "type": "string",
      "source": "html",
      "selector": "h2",
      "default": "Preguntas Frecuentes"
    },
    "descripcion": {
      "type": "string",
      "source": "html",
      "selector": ".section-description",
      "default": "Encuentra respuestas a tus dudas"
    },
    "preguntas": {
      "type": "array",
      "default": [
        {
          "pregunta": "¿Pregunta de ejemplo?",
          "respuesta": "Respuesta de ejemplo"
        }
      ]
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "tituloColor": {
      "type": "string",
      "default": ""
    },
    "descripcionColor": {
      "type": "string",
      "default": ""
    },
    "preguntaColor": {
      "type": "string",
      "default": "#2d6a4f"
    },
    "respuestaColor": {
      "type": "string",
      "default": "#333333"
    },
    "cardBgColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "tituloFontSize": {
      "type": "number",
      "default": 40
    },
    "descripcionFontSize": {
      "type": "number",
      "default": 18
    },
    "preguntaFontSize": {
      "type": "number",
      "default": 18
    },
    "respuestaFontSize": {
      "type": "number",
      "default": 16
    },
    "textAlign": {
      "type": "string",
      "default": "center"
    }
  }
}